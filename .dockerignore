# Ignore local environment and secrets
.design/
.scion/
.gemini/
*.key
*.pem
*.secret
*.env

# Ignore version control (can be large)
.git/

# Ignore IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Ignore test artifacts and binaries
*.test
*.out
coverage.txt

# node_modules/ must precede the !web/ re-includes so that
# web/node_modules/ stays excluded even after the negation patterns.
node_modules/
!web/**/*.js
!web/**/*.ts
!web/**/*.json

# Ignore documentation not needed for build
*.md
!go.mod
!go.sum

# Ignore other common large directories
vendor/
tmp/
.cache/
