{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  // Type-checks the Playwright config files and the vitest worker-count
  // helper, which the root project does not include, and the unit tests
  // that check them, and the CI web_checks path-filter guard. Run by the
  // typecheck script.
  "include": [
    "playwright.config.ts",
    "e2e/**/playwright*.config.ts",
    "src/utils/playwright-forbid-only.test.ts",
    "vitest-workers.ts",
    "src/utils/vitest-workers.test.ts",
    "src/utils/ci-web-checks-filter.test.ts"
  ],
  "exclude": []
}
