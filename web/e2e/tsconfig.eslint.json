{
  // Lint-only TS project for the e2e suites whose own tsconfig is the
  // shared shape (extends ../../tsconfig.json, includes ../../src). One
  // program for all of them keeps typed ESLint memory flat instead of
  // loading src once per suite. Not a typecheck config: each suite's
  // tsconfig.json still owns its typecheck.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true
  },
  "include": [
    "./agent-create-secrets/*.ts",
    "./agent-store-count/*.ts",
    "./artifacts-access/*.ts",
    "./artifacts-agent-owned/*.ts",
    "./artifacts-review/*.ts",
    "./chat/*.ts",
    "./chat-decisions/*.ts",
    "./chat-file-preview/*.ts",
    "./chat-mobile/*.ts",
    "./chat-palette/*.ts",
    "./dialog-nested-popup/*.ts",
    "./project-files-tabs/*.ts",
    "./secret-request/*.ts",
    "./terminal-entrypoints/*.ts",
    "./terminal-hidden/*.ts",
    "./terminal-pane/*.ts",
    "./terminal-workspace/*.ts",
    "./test-hub-banner/*.ts",
    "./maintenance-preflight/*.ts",
    "./broker-area/*.ts",
    "./test-identity-session/*.ts",
    "./page-policy/*.ts",
    "./iap-driver/*.ts",
    "./iap-journey/*.ts",
    "./harness-selftest/*.ts",
    "./async-create/*.ts",
    "./client-main-stub.ts",
    "./event-source-stub.ts",
    "./palette-focus.ts",
    "./palette-typography.ts",
    "./*.spec.ts",
    "./groups/*.ts",
    "./harness/*.ts",
    "./roles/*.ts",
    "./system-one/*.ts",
    "./terminal-coordinator/*.ts",
    "./tokens/*.ts",
    "../playwright-chromium.ts",
    "../src/**/*.ts"
  ],
  "exclude": ["../src/**/*.test.ts"]
}
