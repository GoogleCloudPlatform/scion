{
  "metadata": {
    "name": "test-agent",
    "namespace": "default"
  },
  "spec": {
    "volumes": [
      {
        "name": "workspace",
        "emptyDir": {}
      },
      {
        "name": "secrets-store",
        "csi": {
          "driver": "secrets-store-gke.csi.k8s.io",
          "readOnly": true,
          "volumeAttributes": {
            "secretProviderClass": "scion-agent-test-agent"
          }
        }
      }
    ],
    "containers": [
      {
        "name": "agent",
        "image": "test:latest",
        "command": [
          "sh",
          "-c",
          "while [ ! -f /tmp/.scion-home-ready ]; do sleep 0.2; done; exec sciontool init -- sh -c \"$SCION_START_CMD\""
        ],
        "workingDir": "/workspace",
        "env": [
          {
            "name": "SCION_START_CMD",
            "value": "tmux new-session -d -s scion -n agent sh -c 'sleep infinity; echo $? \u003e /tmp/scion-harness-exit-code' \\; set-option -g window-size latest \\; new-window -t scion -n shell \\; select-window -t scion:agent \\; attach-session -t scion"
          },
          {
            "name": "API_KEY",
            "valueFrom": {
              "secretKeyRef": {
                "name": "scion-agent-test-agent",
                "key": "API_KEY"
              }
            }
          },
          {
            "name": "SCION_HOST_UID",
            "value": "HOST_UID"
          },
          {
            "name": "SCION_HOST_GID",
            "value": "HOST_GID"
          },
          {
            "name": "HOME",
            "value": "/home/scion"
          },
          {
            "name": "USER",
            "value": "scion"
          },
          {
            "name": "LOGNAME",
            "value": "scion"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "250m",
            "ephemeral-storage": "10Gi",
            "memory": "512Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "workspace",
            "mountPath": "/workspace"
          },
          {
            "name": "secrets-store",
            "readOnly": true,
            "mountPath": "/etc/ssl/cert.pem",
            "subPath": "TLS_CERT"
          },
          {
            "name": "secrets-store",
            "readOnly": true,
            "mountPath": "/run/scion/secrets-store"
          }
        ],
        "imagePullPolicy": "IfNotPresent",
        "securityContext": {
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "allowPrivilegeEscalation": false
        },
        "stdin": true,
        "tty": true
      }
    ],
    "restartPolicy": "Never",
    "securityContext": {
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "runAsNonRoot": true,
      "fsGroup": -1,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    }
  },
  "status": {}
}
