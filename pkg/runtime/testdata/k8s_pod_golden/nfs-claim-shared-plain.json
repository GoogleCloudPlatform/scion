{
  "metadata": {
    "name": "test-agent",
    "namespace": "default",
    "labels": {
      "scion.project": "myproject"
    }
  },
  "spec": {
    "volumes": [
      {
        "name": "workspace",
        "persistentVolumeClaim": {
          "claimName": "scion-workspaces"
        }
      },
      {
        "name": "shared-dir-0",
        "persistentVolumeClaim": {
          "claimName": "scion-workspaces"
        }
      },
      {
        "name": "shared-dir-1",
        "persistentVolumeClaim": {
          "claimName": "scion-workspaces",
          "readOnly": true
        }
      }
    ],
    "initContainers": [
      {
        "name": "workspace-provision",
        "image": "test:latest",
        "command": [
          "sciontool",
          "provision",
          "--uid",
          "1000",
          "--gid",
          "1000"
        ],
        "env": [
          {
            "name": "SCION_PROVISION_STATE_DIR",
            "value": "/scion-provision"
          },
          {
            "name": "SCION_PROJECT_ID",
            "value": "proj-123"
          },
          {
            "name": "SCION_SHARED_DIR_PATHS",
            "value": "notes=/scion-volumes/notes,cache=/workspace/.scion-volumes/cache"
          },
          {
            "name": "SCION_PROVISION_CHOWN_BEST_EFFORT",
            "value": "1"
          }
        ],
        "resources": {},
        "volumeMounts": [
          {
            "name": "workspace",
            "mountPath": "/workspace",
            "subPath": "projects/proj-123/workspace"
          },
          {
            "name": "workspace",
            "mountPath": "/scion-provision",
            "subPath": "projects/proj-123/provision"
          },
          {
            "name": "shared-dir-0",
            "mountPath": "/scion-volumes/notes",
            "subPath": "projects/proj-123/shared-dirs/notes"
          },
          {
            "name": "shared-dir-1",
            "mountPath": "/workspace/.scion-volumes/cache",
            "subPath": "projects/proj-123/shared-dirs/cache"
          }
        ],
        "terminationMessagePolicy": "FallbackToLogsOnError",
        "securityContext": {
          "capabilities": {
            "add": [
              "CHOWN",
              "FOWNER",
              "DAC_OVERRIDE"
            ],
            "drop": [
              "ALL"
            ]
          },
          "runAsUser": 0,
          "runAsGroup": 0,
          "runAsNonRoot": false,
          "allowPrivilegeEscalation": false
        }
      }
    ],
    "containers": [
      {
        "name": "agent",
        "image": "test:latest",
        "command": [
          "sh",
          "-c",
          "while [ ! -f /tmp/.scion-home-ready ]; do sleep 0.2; done; exec sciontool init -- sh -c \"$SCION_START_CMD\""
        ],
        "workingDir": "/workspace",
        "env": [
          {
            "name": "SCION_START_CMD",
            "value": "tmux new-session -d -s scion -n agent sh -c 'sleep infinity; echo $? \u003e /tmp/scion-harness-exit-code' \\; set-option -g window-size latest \\; new-window -t scion -n shell \\; select-window -t scion:agent \\; attach-session -t scion"
          },
          {
            "name": "SCION_WORKSPACE_GIT",
            "value": "false"
          },
          {
            "name": "SCION_HOST_UID",
            "value": "HOST_UID"
          },
          {
            "name": "SCION_HOST_GID",
            "value": "HOST_GID"
          },
          {
            "name": "HOME",
            "value": "/home/scion"
          },
          {
            "name": "USER",
            "value": "scion"
          },
          {
            "name": "LOGNAME",
            "value": "scion"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "250m",
            "ephemeral-storage": "10Gi",
            "memory": "512Mi"
          }
        },
        "volumeMounts": [
          {
            "name": "workspace",
            "mountPath": "/workspace",
            "subPath": "projects/proj-123/workspace"
          },
          {
            "name": "workspace",
            "readOnly": true,
            "mountPath": "/workspace/.scion",
            "subPath": "projects/proj-123/workspace/.scion"
          },
          {
            "name": "shared-dir-0",
            "mountPath": "/scion-volumes/notes",
            "subPath": "projects/proj-123/shared-dirs/notes"
          },
          {
            "name": "shared-dir-1",
            "readOnly": true,
            "mountPath": "/workspace/.scion-volumes/cache",
            "subPath": "projects/proj-123/shared-dirs/cache"
          }
        ],
        "imagePullPolicy": "IfNotPresent",
        "securityContext": {
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "allowPrivilegeEscalation": false
        },
        "stdin": true,
        "tty": true
      }
    ],
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "securityContext": {
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "runAsNonRoot": true,
      "fsGroup": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    }
  },
  "status": {}
}
