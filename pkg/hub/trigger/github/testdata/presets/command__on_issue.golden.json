{
  "match": {
    "types": [
      "github.issue_comment.created",
      "github.issues.opened"
    ],
    "rules": [
      {
        "dialect": "cel",
        "expr": "event.attributes.command == 'plan' && event.attributes.is_pull_request == 'false' && event.attributes.author_association in ['OWNER', 'MEMBER', 'COLLABORATOR'] && event.attributes.sender_type != 'Bot'"
      }
    ]
  },
  "subject": {
    "mode": "new"
  },
  "form": {
    "preset": "github.command",
    "version": 1,
    "fields": {
      "allow_bots": false,
      "allowed_associations": [
        "OWNER",
        "MEMBER",
        "COLLABORATOR"
      ],
      "command": "plan",
      "include_body": false,
      "include_forks": false,
      "include_review_comments": true,
      "on": "issue"
    }
  },
  "suggested_action": {
    "type": "dispatch_agent",
    "agentName": "issue-${event.attributes.number}-plan",
    "template": "default",
    "task": "Handle `/plan` on ${event.attributes.repo}#${event.attributes.number} (${event.attributes.title}) requested by @${event.attributes.sender}.\nCommand arguments: ${event.attributes.command_args?}\nSource URL: ${event.attributes.html_url}\nUse `gh` (authenticated as the GitHub App installation) to post results on the PR/issue, mention @${event.attributes.sender} when answering, and never include an `@<app> /<command>` slash-command mention in comments.",
    "labels": {
      "github_command": "${event.attributes.command}",
      "issue": "${event.attributes.repo}#${event.attributes.number}"
    },
    "ephemeral": false,
    "githubToken": "installation",
    "reuseMessage": "New ${event.type} on ${event.subject}: ${event.attributes.action} by @${event.attributes.sender}. Command: /${event.attributes.command?} ${event.attributes.command_args?}",
    "ackComment": {
      "body": "Started **${result.agent_name}** for `/${event.attributes.command}` — [open agent](${result.agent_url}). Requested by @${event.attributes.sender}."
    },
    "untrustedVars": [
      "event.attributes.repo",
      "event.attributes.number",
      "event.attributes.title",
      "event.attributes.sender",
      "event.attributes.command_args",
      "event.attributes.html_url",
      "event.attributes.command",
      "event.type",
      "event.subject",
      "event.attributes.action"
    ]
  },
  "suggested_actions": [
    {
      "type": "dispatch_agent",
      "agentName": "issue-${event.attributes.number}-plan",
      "template": "default",
      "task": "Handle `/plan` on ${event.attributes.repo}#${event.attributes.number} (${event.attributes.title}) requested by @${event.attributes.sender}.\nCommand arguments: ${event.attributes.command_args?}\nSource URL: ${event.attributes.html_url}\nUse `gh` (authenticated as the GitHub App installation) to post results on the PR/issue, mention @${event.attributes.sender} when answering, and never include an `@<app> /<command>` slash-command mention in comments.",
      "labels": {
        "github_command": "${event.attributes.command}",
        "issue": "${event.attributes.repo}#${event.attributes.number}"
      },
      "ephemeral": false,
      "githubToken": "installation",
      "reuseMessage": "New ${event.type} on ${event.subject}: ${event.attributes.action} by @${event.attributes.sender}. Command: /${event.attributes.command?} ${event.attributes.command_args?}",
      "ackComment": {
        "body": "Started **${result.agent_name}** for `/${event.attributes.command}` — [open agent](${result.agent_url}). Requested by @${event.attributes.sender}."
      },
      "untrustedVars": [
        "event.attributes.repo",
        "event.attributes.number",
        "event.attributes.title",
        "event.attributes.sender",
        "event.attributes.command_args",
        "event.attributes.html_url",
        "event.attributes.command",
        "event.type",
        "event.subject",
        "event.attributes.action"
      ]
    }
  ]
}
