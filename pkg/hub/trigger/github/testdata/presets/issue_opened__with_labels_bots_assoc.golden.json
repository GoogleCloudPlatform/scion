{
  "match": {
    "types": [
      "github.issues.opened"
    ],
    "rules": [
      {
        "dialect": "cel",
        "expr": "event.lists.labels.exists(l, l in ['bug', 'triage:urgent']) && event.attributes.author_association in ['OWNER', 'MEMBER', 'COLLABORATOR', 'FIRST_TIME_CONTRIBUTOR']"
      }
    ]
  },
  "subject": {
    "mode": "new"
  },
  "form": {
    "preset": "github.issue_opened",
    "version": 1,
    "fields": {
      "allow_bots": true,
      "allowed_associations": [
        "OWNER",
        "MEMBER",
        "COLLABORATOR",
        "FIRST_TIME_CONTRIBUTOR"
      ],
      "labels_any": [
        "bug",
        "triage:urgent"
      ]
    }
  },
  "suggested_action": {
    "type": "dispatch_agent",
    "agentName": "issue-${event.attributes.number}-triage",
    "template": "default",
    "task": "Triage newly opened issue ${event.attributes.repo}#${event.attributes.number} (${event.attributes.title}) reported by @${event.attributes.sender}.\nIssue URL: ${event.attributes.html_url}\nIssue body:\n${event.attributes.body?}\nUse `gh` (authenticated as the GitHub App installation) to post results on the PR/issue, mention @${event.attributes.sender} when answering, and never include an `@<app> /<command>` slash-command mention in comments.",
    "labels": {
      "issue": "${event.attributes.repo}#${event.attributes.number}"
    },
    "ephemeral": false,
    "githubToken": "installation",
    "reuseMessage": "New ${event.type} on ${event.subject}: ${event.attributes.action} by @${event.attributes.sender}.",
    "ackComment": {
      "body": "Started **${result.agent_name}** for ${event.subject} — [open agent](${result.agent_url}). Triggered by @${event.attributes.sender}."
    },
    "untrustedVars": [
      "event.attributes.repo",
      "event.attributes.number",
      "event.attributes.title",
      "event.attributes.sender",
      "event.attributes.html_url",
      "event.attributes.body",
      "event.type",
      "event.subject",
      "event.attributes.action"
    ]
  }
}
