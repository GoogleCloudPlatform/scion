{
  "match": {
    "types": [
      "github.issues.labeled"
    ],
    "rules": [
      {
        "dialect": "cel",
        "expr": "event.attributes.label == 'good first issue' && event.attributes.is_pull_request == 'false' && event.attributes.sender_type != 'Bot'"
      }
    ]
  },
  "subject": {
    "mode": "new"
  },
  "form": {
    "preset": "github.label_added",
    "version": 1,
    "fields": {
      "allow_bots": false,
      "include_forks": false,
      "label": "good first issue",
      "on": "issue"
    }
  },
  "suggested_action": {
    "type": "dispatch_agent",
    "agentName": "issue-${event.attributes.number}-labeled",
    "template": "default",
    "task": "Handle label `${event.attributes.label}` added to ${event.attributes.repo}#${event.attributes.number} (${event.attributes.title}) by @${event.attributes.sender}.\nSource URL: ${event.attributes.html_url}\nUse `gh` (authenticated as the GitHub App installation) to post results on the PR/issue, mention @${event.attributes.sender} when answering, and never include an `@<app> /<command>` slash-command mention in comments.",
    "labels": {
      "issue": "${event.attributes.repo}#${event.attributes.number}"
    },
    "ephemeral": false,
    "githubToken": "installation",
    "reuseMessage": "New ${event.type} on ${event.subject}: label `${event.attributes.label}` added by @${event.attributes.sender}.",
    "ackComment": {
      "body": "Started **${result.agent_name}** for ${event.subject} — [open agent](${result.agent_url}). Triggered by @${event.attributes.sender}."
    },
    "untrustedVars": [
      "event.attributes.label",
      "event.attributes.repo",
      "event.attributes.number",
      "event.attributes.title",
      "event.attributes.sender",
      "event.attributes.html_url",
      "event.type",
      "event.subject"
    ]
  }
}
