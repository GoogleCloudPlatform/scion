{
  "match": {
    "types": [
      "github.pull_request.synchronize"
    ],
    "rules": [
      {
        "dialect": "cel",
        "expr": "event.attributes.base_ref == 'main' && event.attributes.author_association in ['OWNER', 'MEMBER', 'COLLABORATOR']"
      }
    ]
  },
  "subject": {
    "mode": "reuse",
    "coalesce_window": "2m0s"
  },
  "form": {
    "preset": "github.pr_updated",
    "version": 1,
    "fields": {
      "allow_bots": true,
      "allowed_associations": [
        "OWNER",
        "MEMBER",
        "COLLABORATOR"
      ],
      "base_branches": [
        "main"
      ],
      "coalesce_window": "2m0s",
      "include_drafts": true,
      "include_forks": true
    }
  },
  "suggested_action": {
    "type": "dispatch_agent",
    "agentName": "pr-${event.attributes.number}-sync",
    "template": "default",
    "task": "Inspect updated commits on pull request ${event.attributes.repo}#${event.attributes.number} (${event.attributes.title}) pushed by @${event.attributes.sender} targeting `${event.attributes.base_ref}` at head `${event.attributes.head_sha}`.\nPull request URL: ${event.attributes.html_url}\nThis rule admits fork pull requests (`is_fork=${event.attributes.is_fork}`); check out the PR head with `gh pr checkout ${event.attributes.number}`.\nUse `gh` (authenticated as the GitHub App installation) to post results on the PR/issue, mention @${event.attributes.sender} when answering, and never include an `@<app> /<command>` slash-command mention in comments.",
    "labels": {
      "issue": "${event.attributes.repo}#${event.attributes.number}"
    },
    "ephemeral": false,
    "githubToken": "installation",
    "reuseMessage": "New ${event.type} on ${event.subject}: ${event.attributes.action} by @${event.attributes.sender} at head ${event.attributes.head_sha}.",
    "ackComment": {
      "body": "Started **${result.agent_name}** for ${event.subject} — [open agent](${result.agent_url}). Triggered by @${event.attributes.sender}."
    },
    "untrustedVars": [
      "event.attributes.repo",
      "event.attributes.number",
      "event.attributes.title",
      "event.attributes.sender",
      "event.attributes.base_ref",
      "event.attributes.head_sha",
      "event.attributes.html_url",
      "event.attributes.is_fork",
      "event.type",
      "event.subject",
      "event.attributes.action"
    ]
  }
}
