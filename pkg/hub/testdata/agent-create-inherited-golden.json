{
  "description": "Inherited create-time values, one case per tier. sources is the input, written by hand: what the web reads from existing APIs, in their response shapes (template: a template list item; projectSettings: GET /api/v1/projects/{id}/settings; hubSettings: GET /api/v1/settings/public). dispatched is generated from the hub's actual dispatch by go test ./pkg/hub -run TestCreateAgent_InheritedValuesGolden -update, by the web form's field key, for an agent created with no config keys. The web's inherited-placeholder test checks its placeholders against dispatched.",
  "cases": [
    {
      "tier": "template",
      "sources": {
        "template": {
          "config": {
            "model": "template-model",
            "messageMode": "lineage",
            "telemetry": {
              "enabled": true
            },
            "env": {
              "SCION_AUTO_EXPOSE_PORTS": "true"
            }
          }
        },
        "projectSettings": {},
        "hubSettings": {}
      },
      "dispatched": {
        "autoExpose": "true",
        "config.model": "template-model",
        "config.telemetry": "true",
        "messageMode": "lineage"
      }
    },
    {
      "tier": "project",
      "sources": {
        "template": {
          "config": {
            "model": "template-model",
            "telemetry": {
              "enabled": true
            },
            "env": {
              "SCION_AUTO_EXPOSE_PORTS": "true"
            }
          }
        },
        "projectSettings": {
          "defaultModel": "project-model",
          "defaultThinkingLevel": 7,
          "defaultMaxTurns": 40,
          "defaultMaxModelCalls": 300,
          "defaultMaxDuration": "2h",
          "defaultResources": {
            "requests": {
              "cpu": "2",
              "memory": "4Gi"
            },
            "limits": {
              "cpu": "4",
              "memory": "8Gi"
            },
            "disk": "20Gi"
          },
          "telemetryEnabled": false,
