        "config.auth_selectedType": "api-key",
        "config.max_duration": "2h",
        "config.max_model_calls": "300",
        "config.max_turns": "40",
        "config.model": "project-model",
        "config.resources.disk": "20Gi",
        "config.resources.limits.cpu": "4",
        "config.resources.limits.memory": "8Gi",
        "config.resources.requests.cpu": "2",
        "config.resources.requests.memory": "4Gi",
        "config.telemetry": "false",
        "config.thinking_level": "7"
      }
