# cr-ci configuration contract
#
# The single source of configuration for cr-ci. Copy to config.env (gitignored),
# fill in the REQUIRED values, and pass it to the scripts in scripts/ (P4). The
# deploy scripts set the same variables on the mediator Cloud Run service,
# whose loader (mediator/config.go) validates exactly this set. A test keeps
# this file and the loader in lockstep.
#
# Format: KEY=value, one per line, no quotes, no shell expansion. The scripts
# parse this file line by line and never source it, so a value may contain
# spaces (RECONCILE_SCHEDULE does). Every key has a comment directly above
# it. Leaving a value empty means "use the default" (shown as the value
# here); REQUIRED keys have no default.
#
# This file holds resource NAMES only. Never put a secret VALUE (the GitHub App
# private key, the webhook secret, any token) in it. Secret values live only in
# Secret Manager; see docs/gcp-setup.md and docs/operations.md.

# --- Target -------------------------------------------------------------------

# REQUIRED. Comma-separated owner/repo list the mediator will serve. Webhooks
# for any other repository are rejected. Examples: ptone/scion (fork),
# GoogleCloudPlatform/scion (upstream), or both: ptone/scion,GoogleCloudPlatform/scion
TARGET_REPOS=

# REQUIRED. Numeric ID of the GitHub App (App settings page, "App ID"). Not secret.
GITHUB_APP_ID=

# Where the App is installed: "repo" (repository installation; the mediator
# calls /repos/{owner}/{repo}/actions/runners/*; works for personal accounts and
# orgs; the common case and the only one for a personal account such as the
# fork) or "org" (organization installation using org-level runners
# /orgs/{org}/actions/runners/*; organizations only, and all TARGET_REPOS must
# then share one owner). See docs/permissions-matrix.md.
GITHUB_APP_INSTALLATION_SCOPE=repo

# --- GCP placement --------------------------------------------------------------

# REQUIRED. GCP project ID that hosts the mediator, runner job, secrets and images.
GCP_PROJECT=

# REQUIRED. Cloud Run region for the mediator and the runner job, e.g.
# us-central1 (Tier 1 pricing). Any region with Cloud Run Jobs works; see
# docs/gcp-setup.md, "Region choice".
REGION=

# --- Runner job -----------------------------------------------------------------

# Runner label that workflows target (runs-on) and that the mediator filters
# on. Must be unique: never self-hosted, Linux, X64 or ARM64.
RUNNER_LABEL=scion-cr-8c32g

# How long a runner's one-time claim token stays valid (Go duration, 30s-1h).
# The runner exchanges it at MEDIATOR_URL/internal/claim for its JIT config;
# allow for the cold start of the large runner image.
CLAIM_TTL=300s

# Name of the Cloud Run Job each runner execution is started from.
RUNNER_JOB_NAME=cr-gh-runner-8c32g

# Image name inside ARTIFACT_REPO; the full reference is
# REGION-docker.pkg.dev/GCP_PROJECT/ARTIFACT_REPO/RUNNER_IMAGE_NAME.
RUNNER_IMAGE_NAME=gh-runner

# Image name of the mediator inside ARTIFACT_REPO (built from mediator/Dockerfile
# by deploy-mediator.sh). Must differ from RUNNER_IMAGE_NAME.
MEDIATOR_IMAGE_NAME=cr-runner-mediator

# vCPUs per runner: 1, 2, 4, 6 or 8 (Cloud Run Jobs maximum without GPU is 8).
RUNNER_CPU=8

# Memory per runner, as <n>Mi or <n>Gi. Must fit RUNNER_CPU: 4 CPU allows up
# to 16Gi, 6 CPU up to 24Gi, 8 CPU up to 32Gi (the Cloud Run maximum).
RUNNER_MEMORY=32Gi

# Size in GiB of the ephemeral-disk volume mounted at /scratch (1-100). The
# runner's workspace, temp dirs and Go caches live there so they do not
# consume RAM. Cloud Run allows 10 GiB per instance by default; more needs the
# per-instance quota (run.googleapis.com/max_per_instance_ephemeral_disk)
# raised first. A warm golangci-lint with the build cache on disk needs at least
# 20 GiB (P6b peak 16.5 GB), so 10 is too small for it; see docs/gcp-setup.md,
# "Quotas". The limit the server enforces depends on the region and its quota
# grant (P6b: us-west2 runs at 23 GiB, its limit; us-central1 was 10). Regional
# ephemeral-disk quota is consumed as RUNNER_DISK_GI x running executions.
RUNNER_DISK_GI=10

# Upper bound on concurrently running runner executions; the mediator leaves
# jobs queued in GitHub above it. Keep RUNNER_DISK_GI x this value within the
# regional ephemeral-disk quota (default 100 GiB: 5 x 10 GiB fits, 5 x 25 GiB
# does not). Raise it only after the quota increase described in docs/gcp-setup.md.
MAX_CONCURRENT_RUNNERS=5

# true: keep the runner's ~/.cache (the Go build cache and golangci-lint's analysis
# cache) in RAM instead of on /scratch, for a /scratch too small for a warm lint
# (the 10 GiB per-instance default). It counts against RUNNER_MEMORY: in the P6
# PoC the lint's compile peaked near 21 GB and the cache grew to ~9.5 GB, 27.9 GB
# of 32 GiB in total, so it requires RUNNER_MEMORY=32Gi (the loader rejects
# less). Raising the disk quota (RUNNER_DISK_GI ~25) is the roomier option.
# true or false.
RUNNER_BUILD_CACHE_IN_RAM=false

# Hard Cloud Run task timeout for one runner execution (Go duration, 1m-168h).
# Keep it above the longest timeout-minutes of any routed workflow job.
TASK_TIMEOUT=45m

# How long a runner may wait for its first job before it stops itself (Go
# duration, at least 1m, at most half of TASK_TIMEOUT). GitHub can hand a queued
# job to any idle cr-ci runner, and that job only gets what is left of the
# runner's TASK_TIMEOUT; this bounds the loss to RUNNER_IDLE_TIMEOUT (P6: a job
# taken by a 40-minute-old runner was killed after 5 minutes). An idle runner that
# stops is reaped and its job re-served by /reconcile.
RUNNER_IDLE_TIMEOUT=10m

# --- Supporting resources ---------------------------------------------------------

# Artifact Registry (Docker format) repository ID for the runner image.
ARTIFACT_REPO=cr-runners

# Cloud Storage bucket for Cloud Build source uploads (gcloud builds submit
# --gcs-source-staging-dir). bootstrap-gcp.sh creates it (uniform access,
# objects deleted after 7 days) and grants BUILD_SA_NAME read access on this
# bucket only. Empty means <GCP_PROJECT>-cr-ci-staging. Bucket names are
# global: set another name if that one is taken.
BUILD_STAGING_BUCKET=

# Name of the mediator Cloud Run service (receives the GitHub webhook).
MEDIATOR_SERVICE_NAME=cr-runner-mediator

# Mediator min-instances: 0 (scale to zero) or 1 (one instance kept warm).
# max-instances is always 1. At 0, webhook deliveries that arrive while the
# single instance cold-starts can get 429 from Cloud Run, and GitHub does not
# retry them (us-west2: 2 of the first deliveries); /reconcile then backfills
# the job within RECONCILE_SCHEDULE. 1 removes that delay and keeps in-memory
# claims across idle periods, for the idle charge of one 1 vCPU / 512 MiB
# instance around the clock (docs/operations.md, "Mediator: single instance").
MEDIATOR_MIN_INSTANCES=0

# Name of the Cloud Scheduler job that calls the mediator's /reconcile endpoint.
RECONCILER_JOB_NAME=cr-runner-reconciler

# Five-field Unix cron schedule (Cloud Scheduler, UTC) for the reconciler.
# It backfills queued jobs with no runner and removes stale registrations. It is
# also what serves jobs left queued because MAX_CONCURRENT_RUNNERS was reached:
# with cr-ci as a repository's primary runner, use every minute (*/1 * * * *,
# Cloud Scheduler's minimum) so a freed slot is refilled within about a minute.
RECONCILE_SCHEDULE=*/5 * * * *

# Public https origin of the mediator service, e.g.
# https://cr-runner-mediator-abc123-uc.a.run.app (no path). Empty until the
# first deploy-mediator.sh run prints it. It is the OIDC audience the
# reconciler's token must carry, the base of the runners' claim endpoint, and
# the base of the GitHub App webhook URL (MEDIATOR_URL/webhook).
MEDIATOR_URL=

# Runner group ID passed to generate-jitconfig. GitHub's schema requires it
# even for repo-level runners, where 1 (the default group) is used. With org
# scope, set it to the group that allows the target public repos
# (docs/permissions-matrix.md, step G7).
GITHUB_RUNNER_GROUP_ID=1

# Name of the GitHub Actions configuration variable that routes jobs to the
# runner label (the fallback toggle; see docs/operations.md). Must match the
# vars.<NAME> reference in the workflow runs-on expression.
ROUTING_VARIABLE_NAME=SCION_LARGE_RUNNER

# --- Service accounts (account IDs, without @PROJECT.iam.gserviceaccount.com) ----

# Builds and pushes the runner image (Cloud Build). Artifact Registry writer
# on ARTIFACT_REPO only.
BUILD_SA_NAME=cr-runner-build-sa

# Identity of the mediator service. Reads the two secrets below, runs the
# runner job, and acts as EXEC_SA_NAME when doing so.
MEDIATOR_SA_NAME=cr-runner-mediator-sa

# Identity Cloud Scheduler uses to call /reconcile. Run invoker on the mediator only.
SCHEDULER_SA_NAME=cr-runner-scheduler-sa

# Identity of the runner containers. Holds NO IAM roles: workflow code can read
# its metadata-server token, so that token must be worthless.
EXEC_SA_NAME=cr-runner-exec-sa

# --- Secret Manager secret NAMES (never values) ----------------------------------

# Secret holding the GitHub App private key (PEM).
GITHUB_APP_PRIVATE_KEY_SECRET_NAME=cr-runner-gh-app-private-key

# Secret holding the GitHub App webhook secret (HMAC key for X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET_NAME=cr-runner-gh-webhook-secret
