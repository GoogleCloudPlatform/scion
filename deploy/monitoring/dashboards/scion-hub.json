{
  "displayName": "Scion Hub",
  "dashboardFilters": [
    {
      "labelKey": "scion_hub_id",
      "filterType": "METRIC_LABEL"
    }
  ],
  "labels": {
    "scion": ""
  },
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 48,
        "height": 4,
        "widget": {
          "title": "Database connection pool",
          "sectionHeader": {
            "subtitle": "Hub database connection pools (store and events), per hub replica.",
            "dividerBelow": true
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 16,
        "height": 16,
        "widget": {
          "title": "DB pool: active connections",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"workload.googleapis.com/scion.db.pool.connections.active\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MAX",
                      "crossSeriesReducer": "REDUCE_MAX",
                      "groupByFields": [
                        "metric.label.\"service_instance_id\"",
                        "metric.label.\"pool\""
                      ]
                    }
                  }
                },
                "plotType": "LINE",
                "targetAxis": "Y1",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "${metric.labels.service_instance_id} ${metric.labels.pool}"
              }
            ],
            "timeshiftDuration": "0s",
            "yAxis": {
              "label": "connections",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 4,
        "width": 16,
        "height": 16,
