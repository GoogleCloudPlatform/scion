# Cloud Build source upload filter.
#
# All cloudbuild-*.yaml configs share this ignore file. The union of
# files they need is:
#   image-build/   — Dockerfiles, scripts
#   harnesses/     — harness Dockerfiles and assets
#   cmd/, pkg/     — Go source (compiled in scion-base)
#   resources/     — embedded resources
#   web/*.go       — Go embed stubs only
#   go.mod, go.sum
#
# Everything else is excluded to keep the upload small and fast.
#
# Gitignore semantics: a pattern without a slash matches at any depth, which
# would also drop files under //go:embed roots (e.g. pkg/config/embeds/,
# resources/templates/, harnesses/) from the upload: the build still passes,
# but the files are missing from the binary. So every pattern that names a
# repo-root path is anchored with a leading "/" (patterns with an inner slash,
# such as web/dist/, are already anchored). The few patterns left unanchored
# on purpose say why. cmd/gcloudignore_contract_test.go checks that no tracked
# file under a //go:embed root is matched by any Cloud Build ignore file.

#!include:.gitignore
# (gcloud reads this from the directory of this file: the root .gitignore.)

# ---------------------------------------------------------------------------
# Directories not needed by any Cloud Build config
# ---------------------------------------------------------------------------
/changelog/
/docs/
/docs-repo/
/docs-site/
/examples/
/extras/
/hack/
/internal/
/reviews/
/scratch/
/scripts/
/shared-dirs/
/skills/

# ---------------------------------------------------------------------------
# Web frontend — only web/embed.go and web/embed_stub.go are needed
# (for the no_embed_web Go build tag). Exclude everything else.
# ---------------------------------------------------------------------------
web/dist/
web/node_modules/
web/public/
web/scripts/
web/src/
web/test-scripts/
web/*.md
web/*.json
web/*.ts
web/*.html
web/.env*
web/.eslintrc*
web/.prettierrc*
web/.screenshots/
web/coverage/

# ---------------------------------------------------------------------------
# Test files — Cloud Build compiles Go but never runs tests
# ---------------------------------------------------------------------------
# Unanchored on purpose: Go tests sit next to the code in every package.
*_test.go

# ---------------------------------------------------------------------------
# Build artifacts and tool state
# ---------------------------------------------------------------------------
# .git/, testdata/ and downloads/ are unanchored on purpose:
#   .git/      - VCS metadata of any nested checkout is never build input.
#   testdata/  - Go test fixtures live next to each package (pkg/*/testdata)
#                and Cloud Build does not run tests.
#   downloads/ - agent/harness runtime downloads can land in any directory
#                (mirrors the any-depth downloads/ in .gitignore).
# Everything else here names a repo-root path and is anchored with "/".
.git/
/.claude/
# The root .gitignore (included above) ignores .claude/ at any depth. Re-include
# the harness home dirs that harnesses/embed.go compiles into the binary
# (harnesses/claude/home/.claude/settings.json).
!/harnesses/*/home/.claude/
/.design/
/.scratch/
/.tasks/
/.scion/
/build/
/.build/
testdata/
downloads/

# ---------------------------------------------------------------------------
# CI / IDE / config files not needed for image builds
# ---------------------------------------------------------------------------
/.gemini/
/.geminiignore
/.github/
/.gitignore

# ---------------------------------------------------------------------------
# Root files not needed for image builds
# ---------------------------------------------------------------------------
/claude.md
/gemini.md
/.claudeignore
/.dockerignore
/.coordinator-state.md
/.eng-manager-state.md
/agents.md
/CHANGELOG.md
/GLOSSARY.md
/LICENSE
/Makefile
/README.md
/pr-*-review*.md
