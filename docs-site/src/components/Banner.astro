import DefaultBanner from '@astrojs/starlight/components/Banner.astro';
import {
	extractRelativeDocPath,
	getBuildVersionConfig,
	joinVersionUrl,
	MANIFEST_PATH,
	ROOT_BASE,
} from '../lib/versioning.mjs';

const { base, channel, version } = getBuildVersionConfig();
const showVersionBanner = channel !== 'main';
const relSlug = extractRelativeDocPath(Astro.url.pathname, base);
const mainPageHref = joinVersionUrl(ROOT_BASE, relSlug);

const channelLabelMap = {
	main: 'main',
	stable: 'Stable',
	preview: 'Preview',
	nightly: 'Nightly',
};
const channelLabel = channelLabelMap[channel] || channel;
---

{
	showVersionBanner && (
		<scion-version-banner
			class:list={['scion-version-banner', `scion-banner-${channel}`]}
			data-pagefind-ignore
			data-current-channel={channel}
			data-current-version={version}
			data-current-base={base}
			data-manifest-url={MANIFEST_PATH}
		>
			<span data-role="banner-text">
				Viewing <strong>{channelLabel}</strong> documentation (<code>{version}</code>).
			</span>{' '}
			<span data-role="latest-channel-wrap" hidden>
				<a data-role="latest-channel-link" href={`${ROOT_BASE}/overview/`}>
					Switch to latest {channelLabel}
				</a>
				{' · '}
			</span>
			<a data-role="main-link" href={mainPageHref}>
				View latest on <code>main</code>
			</a>
		</scion-version-banner>
	)
}
<DefaultBanner />

<script>
	import { loadVersionsManifest, navigateToVersionBase } from '../lib/manifest-client.mjs';
	import { findNewerChannelRelease, type ChannelId } from '../lib/versioning.mjs';

	class ScionVersionBanner extends HTMLElement {
		connectedCallback() {
			const channel = (this.dataset.currentChannel || 'main') as ChannelId;
			const version = this.dataset.currentVersion || 'main';
			const base = this.dataset.currentBase || '/scion';
			const manifestUrl = this.dataset.manifestUrl || '/scion/versions.json';

			const mainLink = this.querySelector<HTMLAnchorElement>('a[data-role="main-link"]');
			if (mainLink) {
				mainLink.addEventListener('click', (e) => {
					e.preventDefault();
					void navigateToVersionBase('/scion', base);
				});
			}

			void loadVersionsManifest({ channel, version, base }, manifestUrl).then((manifest) => {
				const newer = findNewerChannelRelease(manifest, { channel, version });
				if (!newer) return;
				const { channelLabel, latestEntry } = newer;

				this.classList.add('scion-banner-outdated');
				const bannerText = this.querySelector<HTMLElement>('[data-role="banner-text"]');
				if (bannerText) {
					bannerText.textContent = '';
					bannerText.append('Viewing an older ');
					const strong = document.createElement('strong');
					strong.textContent = channelLabel;
					bannerText.append(strong, ' snapshot (');
					const code = document.createElement('code');
					code.textContent = version;
					bannerText.append(code, ').');
				}

				const wrap = this.querySelector<HTMLElement>('[data-role="latest-channel-wrap"]');
				const link = this.querySelector<HTMLAnchorElement>('a[data-role="latest-channel-link"]');
				if (wrap && link) {
					link.href = `${latestEntry.path}/overview/`;
					link.textContent = `Switch to ${channelLabel} ${latestEntry.version}`;
					link.addEventListener('click', (e) => {
						e.preventDefault();
						void navigateToVersionBase(latestEntry.path, base);
					});
					wrap.hidden = false;
				}
			});
		}
	}

	if (!customElements.get('scion-version-banner')) {
		customElements.define('scion-version-banner', ScionVersionBanner);
	}
</script>

<style>
	@layer starlight.components {
		.scion-version-banner {
			display: block;
			padding: 0.45rem var(--sl-nav-pad-x);
			background-color: var(--sl-color-bg-sidebar);
			border-bottom: 1px solid var(--sl-color-gray-5);
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			text-align: center;
			text-wrap: balance;
		}

		.scion-version-banner.scion-banner-preview,
		.scion-version-banner.scion-banner-nightly,
		.scion-version-banner.scion-banner-outdated {
			background-color: var(--sl-color-orange-low);
			border-bottom-color: var(--sl-color-orange);
			color: var(--sl-color-orange-high);
		}

		.scion-version-banner a {
			color: var(--sl-color-text-accent);
			font-weight: 500;
			text-decoration: underline;
		}

		.scion-version-banner.scion-banner-preview a,
		.scion-version-banner.scion-banner-nightly a,
		.scion-version-banner.scion-banner-outdated a {
			color: inherit;
		}
	}
</style>
