# Stub openssl for the fix-tls-rotation.sh tests. "openssl s_client ..." is
# logged to $STUB_LOG and prints the certificate the stub Caddy serves
# ($STUB_TLS_STATE/served.pem; nothing if absent, like a closed port). Every
# other call runs the real openssl ($STUB_REAL_OPENSSL), so certificate
# parsing is real.
set -u
if [ "${1:-}" = "s_client" ]; then
  printf 'openssl %s\n' "$*" >> "${STUB_LOG:?}"
  cat >/dev/null
  if [ -f "${STUB_TLS_STATE:?}/served.pem" ]; then
    echo "CONNECTED(00000003)"
    cat "${STUB_TLS_STATE}/served.pem"
    exit 0
  fi
  exit 1
fi
exec "${STUB_REAL_OPENSSL:?}" "$@"
