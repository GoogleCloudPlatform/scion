# Stub systemctl for the fix-tls-rotation.sh tests in
# scripts/starter-hub/tests/run.sh. Never touches the real system. Every call
# is appended to $STUB_LOG; state lives in $STUB_TLS_STATE:
#   cat UNIT                -> exit 0 if $STUB_TLS_STATE/unit-UNIT exists
#   is-enabled UNIT         -> "enabled" if enabled-UNIT exists, else "disabled"
#   is-active [--quiet] U   -> "active" if active-U exists, else "inactive"
#   enable --now UNIT       -> creates enabled-UNIT and active-UNIT
#   show -p User --value caddy -> $STUB_CADDY_USER
#   show -p ExecReload caddy   -> a Caddy ExecReload line, with --force
#                                 unless $STUB_TLS_STATE/execreload-no-force
#   reload caddy            -> "serves" $STUB_TLS_LIVE (copies it to served.pem);
#                              exits 1 instead if $STUB_TLS_STATE/reload-fails
set -u
printf 'systemctl %s\n' "$*" >> "${STUB_LOG:?}"
st="${STUB_TLS_STATE:?}"
case "${1:-}" in
  cat) [ -f "$st/unit-$2" ] || exit 1 ;;
  is-enabled)
    if [ -f "$st/enabled-$2" ]; then echo enabled; else echo disabled; exit 1; fi ;;
  is-active)
    quiet=false
    if [ "$2" = "--quiet" ]; then quiet=true; shift; fi
    if [ -f "$st/active-$2" ]; then $quiet || echo active
    else $quiet || echo inactive; exit 3; fi ;;
  enable)
    [ "$2" = "--now" ] && shift
    : > "$st/enabled-$2"; : > "$st/active-$2" ;;
  show)
    case "$*" in
      *"-p User"*) echo "${STUB_CADDY_USER:-}" ;;
      *"-p ExecReload"*)
        if [ -f "$st/execreload-no-force" ]; then
          echo "ExecReload={ path=/usr/bin/caddy ; argv[]=/usr/bin/caddy reload --config /etc/caddy/Caddyfile ; }"
        else
          echo "ExecReload={ path=/usr/bin/caddy ; argv[]=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --force ; }"
        fi ;;
    esac ;;
  reload)
    if [ "$2" = "caddy" ]; then
      [ ! -f "$st/reload-fails" ] || exit 1
      cp "${STUB_TLS_LIVE:?}" "$st/served.pem"
    fi ;;
esac
exit 0
