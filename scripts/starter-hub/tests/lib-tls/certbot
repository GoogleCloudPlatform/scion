# Stub certbot for the fix-tls-rotation.sh tests. Never contacts an ACME
# server. Logs to $STUB_LOG. "certbot renew --cert-name NAME ..." behaves like
# certbot: unless --force-renewal is given, it renews only when the live
# certificate expires within $STUB_CERTBOT_WINDOW_DAYS (default 30, certbot's
# renew_before_expiry default) and otherwise prints "not yet due". A renewal
# issues a throwaway self-signed certificate (90 days) as the next archive
# version under $FIX_TLS_ROOT/etc/letsencrypt, keeps the previous key's mode
# (like certbot), repoints the live symlinks, then runs each executable in
# renewal-hooks/deploy/ with RENEWED_LINEAGE and RENEWED_DOMAINS set.
set -eu
printf 'certbot %s\n' "$*" >> "${STUB_LOG:?}"
[ "${1:-}" = "renew" ] || exit 0
name=""
prev=""
force=false
for a in "$@"; do
  [ "$prev" = "--cert-name" ] && name="$a"
  [ "$a" = "--force-renewal" ] && force=true
  prev="$a"
done
le="${FIX_TLS_ROOT:?}/etc/letsencrypt"
arch="$le/archive/$name"
window=$(( ${STUB_CERTBOT_WINDOW_DAYS:-30} * 86400 ))
if ! $force && "${STUB_REAL_OPENSSL:?}" x509 -in "$le/live/$name/cert.pem" -noout -checkend "$window" >/dev/null; then
  echo "Certificate not yet due for renewal"
  exit 0
fi
n=1
while [ -e "$arch/cert$n.pem" ]; do n=$((n + 1)); done
oldkey="$(readlink -f "$le/live/$name/privkey.pem")"
"${STUB_REAL_OPENSSL:?}" req -x509 -newkey rsa:2048 -nodes -days 90 -subj "/CN=$name" \
  -keyout "$arch/privkey$n.pem" -out "$arch/cert$n.pem" 2>/dev/null
chmod --reference="$oldkey" "$arch/privkey$n.pem"
cp "$arch/cert$n.pem" "$arch/fullchain$n.pem"
cp "$arch/cert$n.pem" "$arch/chain$n.pem"
for f in cert chain fullchain privkey; do
  ln -sfn "../../archive/$name/$f$n.pem" "$le/live/$name/$f.pem"
done
for h in "$le"/renewal-hooks/deploy/*; do
  [ -x "$h" ] || continue
  RENEWED_LINEAGE="$le/live/$name" RENEWED_DOMAINS="$name *.$name" "$h"
done
