# Stub gcloud for scripts/starter-hub/tests. It never contacts GCP: every
# call is appended to $STUB_LOG, and:
#   config get-value project   -> prints "stub-project"
#   compute scp FILE... DEST    -> copies each local FILE into $STUB_SCP_DIR
#   compute ssh ... --command C -> appends C to $STUB_SSH_LOG, exits 0;
#                                  for "mktemp -d /tmp/NAME.XXXXXX" it also
#                                  prints /tmp/NAME.stub
#   compute instances describe  -> prints a documentation-range IP
#   dns managed-zones describe  -> exits 1 until "create" has run, so a
#                                  fresh test always creates the zone
#   anything else               -> exits 0
set -u
printf 'gcloud %s\n' "$*" >> "${STUB_LOG:?}"
case "$1 ${2:-}" in
  "config get-value") echo "stub-project" ;;
  "compute scp")
    shift 2
    for a in "$@"; do
      if [ -f "$a" ]; then cp "$a" "${STUB_SCP_DIR:?}/"; fi
    done
    ;;
  "compute ssh")
    for a in "$@"; do
      case "$a" in
        --command=*) printf '%s\n' "${a#--command=}" >> "${STUB_SSH_LOG:?}" ;;
      esac
    done
    prev=""
    for a in "$@"; do
      if [ "$prev" = "--command" ]; then printf '%s\n' "$a" >> "${STUB_SSH_LOG:?}"; fi
      prev="$a"
    done
    for a in "$@"; do
      case "$a" in
        *"mktemp -d /tmp/"*.XXXXXX*)
          t="${a#*mktemp -d }"
          t="${t%% *}"
          echo "${t%.XXXXXX}.stub"
          ;;
      esac
    done
    ;;
  "compute instances") echo "203.0.113.10" ;;
  "dns managed-zones")
    zone_marker="$(dirname "${STUB_LOG}")/zone-created"
    case "${3:-}" in
      create) : > "$zone_marker" ;;
      describe) [ -f "$zone_marker" ] || exit 1 ;;
    esac
    ;;
esac
exit 0
