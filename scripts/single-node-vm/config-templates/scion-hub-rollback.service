[Unit]
Description=Scion Hub boot-failure guard (restores the previous release)
# Started by scion-hub.service's OnFailure=. The script acts only when the
# hub failed for good (ActiveState=failed, SubState=failed) after
# crashing; see the script header.

[Service]
Type=oneshot
# A oneshot has no start timeout by default; a hung run would block later
# OnFailure= starts, which merge into it.
TimeoutStartSec=120
ExecStart=/usr/local/libexec/scion/scion-hub-rollback.sh
