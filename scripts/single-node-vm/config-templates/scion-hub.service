[Unit]
Description=Scion Hub
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=scion
Group=scion
EnvironmentFile=/home/scion/.scion/hub.env
ExecStart=/usr/local/bin/scion server start --foreground --hosted --enable-hub --enable-web --web-port 8080 --enable-runtime-broker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
