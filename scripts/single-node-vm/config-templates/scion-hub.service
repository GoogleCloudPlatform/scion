[Unit]
Description=Scion Hub
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=scion
Group=scion
EnvironmentFile=/home/scion/.scion/hub.env
ExecStart=/usr/local/bin/scion server foreground --settings /home/scion/.scion/settings.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
