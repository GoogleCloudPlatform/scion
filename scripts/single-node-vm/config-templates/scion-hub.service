[Unit]
Description=Scion Hub
After=network.target docker.service
Requires=docker.service
# Boot-failure guard (design D1): five starts within 300 s stop the unit
# with Result=start-limit-hit, and OnFailure= then runs the root oneshot
# scion-hub-rollback.service, which restores the previous release.
# StartLimit* belong in [Unit] (systemd >= 230; the VM image has 249).
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=scion-hub-rollback.service

[Service]
Type=simple
User=scion
Group=scion
WorkingDirectory=/home/scion
EnvironmentFile=/home/scion/.scion/hub.env
ExecStart=/opt/scion/current/scion server start --foreground --hosted --enable-hub --enable-web --web-port 8080 --enable-runtime-broker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
