#!/usr/bin/env bash
# scripts/single-node-vm/tests/lib/gcloud — a fake `gcloud` for the
# deploy.sh test harness, put first on PATH by tests/run.sh. Never
# contacts GCP.
#
# Every invocation is appended to $GCLOUD_STUB_LOG, one call per line
# (space-joined argv), so tests can assert on exactly what deploy.sh
# asked gcloud to do. Responses are served from plain files under
# $GCLOUD_STUB_STATE_DIR, which each test populates as its fixture and
# can inspect afterwards to see what would have been created or
# deleted.
#
# Covers the base deploy.sh resources needed to run deploy.sh itself end
# to end against this stub (service account, router, NAT, the base VM,
# firewall rule, Cloud Run deploy/describe/delete, IAP, auth/project
# plumbing). Firewall rules are stored as JSON, mirroring the real
# --format=json shape a caller would parse.
#
# This is the harness core shared across scripts/single-node-vm/tests
# stub-case PRs: keep additions here generic to deploy.sh's own gcloud
# usage (compute/iam/services/run). Feature-specific stub cases (GKE,
# NAT reuse fixtures, IAP firewall scoping, etc.) belong in the PR that
# adds the behavior they cover, layered on top of this file.
#
# The hybrid tier's cases are layered on top: clusters, subnets, internal
# addresses, the GKE-managed firewall rules node-tag discovery reads, the
# IAP OAuth client, the transport service account's keys, and the
# hybrid-tier firewall rules. Firewall rules and clusters are stored as
# JSON, mirroring the real --format=json shape hybrid-tier.sh parses.
#
# --project and --zone are required on every call that takes them in the
# real gcloud CLI; this stub asserts they're present (and non-empty)
# everywhere deploy.sh is expected to pass them -- --project on every
# create/list/delete/describe, --zone on every per-instance call, plus
# --region/--router on regional router/NAT/Cloud Run calls -- and fails
# loudly (not just "not found") if one is missing, rather than silently
# falling back to an ambient default the way real gcloud would.

set -euo pipefail

: "${GCLOUD_STUB_LOG:?GCLOUD_STUB_LOG must be set}"
: "${GCLOUD_STUB_STATE_DIR:?GCLOUD_STUB_STATE_DIR must be set}"

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Deliberately its own variable, not "${PYTHON:-python3}": a test that
# sets PYTHON for deploy.sh's own process (to simulate a missing
# interpreter) exports it to every child process deploy.sh execs,
# including this stub -- which needs a real interpreter for its own JSON
# handling regardless of what deploy.sh is being tested against.
PYTHON="${GCLOUD_STUB_PYTHON:-python3}"

mkdir -p "${GCLOUD_STUB_STATE_DIR}/firewall-rules" "${GCLOUD_STUB_STATE_DIR}/clusters" \
  "${GCLOUD_STUB_STATE_DIR}/gke-node-firewall-rules" \
  "${GCLOUD_STUB_STATE_DIR}/instances" "${GCLOUD_STUB_STATE_DIR}/subnets" "${GCLOUD_STUB_STATE_DIR}/run-services" \
  "${GCLOUD_STUB_STATE_DIR}/addresses" "${GCLOUD_STUB_STATE_DIR}/nats" \
  "${GCLOUD_STUB_STATE_DIR}/networks" "${GCLOUD_STUB_STATE_DIR}/service-accounts"

printf '%s\n' "$*" >> "$GCLOUD_STUB_LOG"

# Every `... list` call prints a gcloud-style WARNING line on stderr,
# success or failure, empty result or not, the way real gcloud can print
# notices on stderr next to a list's --format=json stdout. A caller that
# merges stderr into the output it parses then fails in every test.
for list_word in "${1:-}" "${2:-}" "${3:-}" "${4:-}"; do
  if [[ "$list_word" == "list" ]]; then
    echo "WARNING: gcloud-stub: simulated notice on stderr for: $*" >&2
    break
  fi
done

# get_flag KEY "$@" — echoes the value of --KEY=VALUE among the remaining
# args, or fails (no output) if absent. Matches only the --KEY=VALUE
# form; a caller using the space-separated --KEY VALUE form real gcloud
# also accepts would be reported as a missing flag, not read.
get_flag() {
  local key="$1"
  shift
  local a
  for a in "$@"; do
    case "$a" in
      "--${key}="*) printf '%s' "${a#--"${key}"=}"; return 0 ;;
    esac
  done
  return 1
}

# require_flag KEY "$@" — fails loudly if --KEY=... is missing or empty.
require_flag() {
  local key="$1"
  shift
  local v
  v="$(get_flag "$key" "$@")" || {
    echo "gcloud-stub: missing --${key} on: $*" >&2
    exit 1
  }
  if [[ -z "$v" ]]; then
    echo "gcloud-stub: empty --${key} on: $*" >&2
    exit 1
  fi
}

# require_project "$@" — fails loudly if --project=... is missing or empty.
require_project() {
  require_flag project "$@"
}

# last_segment URL_OR_NAME — the basename, used as the fixture lookup key
# for subnets regardless of whether hybrid-tier.sh passed a bare name or
# a full self-link URL.
last_segment() {
  printf '%s' "${1##*/}"
}

# "routers nats <verb>" is a four-word subcommand (unlike every other
# case below, which is three words plus a resource name at $4, or two
# words plus a name/project at $3), so it needs its own match on
# $1..$4 before the general dispatch. Because the subcommand itself is
# four words, the NAT's own name -- unlike every describe/create/delete
# case below, where the resource name is $4 -- is one word later, at $5.
case "${1:-} ${2:-} ${3:-} ${4:-}" in
  "compute networks subnets describe")
    require_project "$@"
    require_flag region "$@"
    key="$(last_segment "${5:-}")"
    f="${GCLOUD_STUB_STATE_DIR}/subnets/${key}.json"
    if [[ -f "${f}.describe-fail" ]]; then
      echo "gcloud-stub: simulated describe failure for subnet ${key}" >&2
      exit 1
    fi
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/subnets/${key}.missing" ]]; then
      echo "gcloud-stub: ERROR: (gcloud.compute.networks.subnets.describe) Could not fetch resource: subnetwork '${key}' not found" >&2
      exit 1
    fi
    format="$(get_flag format "$@")" || format=""
    # Callers are told apart by --format.
    if [[ "$format" == "json" ]]; then
      if [[ -f "$f" ]]; then
        cat "$f"
        exit 0
      fi
      # No explicit fixture: every cluster fixture (seed_cluster) implicitly
      # names its subnet "default-subnet", so tests that don't care about
      # the actual CIDR value don't need to seed one explicitly.
      echo '{"ipCidrRange": "10.128.0.0/20"}'
      exit 0
    fi
    # Default to a realistic auto-mode "default" subnet CIDR (matching
    # real GCP's us-central1 default subnet) when a test hasn't overridden
    # it with set_subnet_cidr -- most tests don't care about the exact
    # value, only that a real one comes back.
    cidr="$(cat "${GCLOUD_STUB_STATE_DIR}/subnets/${key}.cidr" 2>/dev/null || echo "10.128.0.0/20")"
    if [[ "$format" == "value(ipCidrRange)" || -z "$format" ]]; then
      echo "$cidr"
    fi
    exit 0
    ;;
  "compute routers nats describe")
    require_project "$@"
    require_flag region "$@"
    require_flag router "$@"
    name="${5:-}"
    if [[ -n "$name" && -f "${GCLOUD_STUB_STATE_DIR}/nats/${name}.exists" ]]; then
      exit 0
    fi
    exit 1
    ;;
  "compute routers nats create")
    require_project "$@"
    require_flag region "$@"
    require_flag router "$@"
    name="${5:-}"
    if [[ -n "$name" ]]; then
      mkdir -p "${GCLOUD_STUB_STATE_DIR}/nats"
      touch "${GCLOUD_STUB_STATE_DIR}/nats/${name}.exists"
    fi
    exit 0
    ;;
  "compute routers nats delete")
    require_project "$@"
    require_flag region "$@"
    require_flag router "$@"
    name="${5:-}"
    # A name-scoped delete-error fixture fails the delete; its content,
    # if any, is the stderr text (so a test can supply a positive
    # not-found or any other error), else a generic failure.
    if [[ -n "$name" && -f "${GCLOUD_STUB_STATE_DIR}/nats/${name}.delete-error" ]]; then
      err_msg="$(cat "${GCLOUD_STUB_STATE_DIR}/nats/${name}.delete-error")"
      echo "${err_msg:-gcloud-stub: simulated delete failure for NAT ${name}}" >&2
      exit 1
    fi
    [[ -n "$name" ]] && rm -f "${GCLOUD_STUB_STATE_DIR}/nats/${name}.exists"
    exit 0
    ;;
  "beta run services update")
    require_project "$@"
    require_flag region "$@"
    exit 0
    ;;
  "beta services identity create")
    require_project "$@"
    exit 0
    ;;
  "iam service-accounts keys list")
    require_project "$@"
    require_flag iam-account "$@"
    if [[ "$(get_flag managed-by "$@" || true)" != "user" ]]; then
      echo "gcloud-stub: keys list is expected to pass --managed-by=user on: $*" >&2
      exit 1
    fi
    sa_email="$(get_flag iam-account "$@")"
    f="${GCLOUD_STUB_STATE_DIR}/service-accounts/${sa_email}.json"
    if [[ -f "${f}.keys-list-error" ]]; then
      echo "gcloud-stub: ERROR: (gcloud.iam.service-accounts.keys.list) PERMISSION_DENIED: Permission iam.serviceAccountKeys.list denied on resource" >&2
      exit 1
    fi
    if [[ -f "${f}.user-keys" ]]; then
      cat "${f}.user-keys"
    fi
    exit 0
    ;;
esac

case "${1:-} ${2:-}" in
  "projects add-iam-policy-binding")
    # Answers as for a project whose IAM policy already contains
    # conditional bindings: gcloud refuses, in non-interactive mode, a
    # binding that does not pass --condition, so every call here must
    # carry --condition=None.
    if [[ "$(get_flag condition "$@" || true)" != "None" ]]; then
      echo "ERROR: (gcloud.projects.add-iam-policy-binding) Adding a binding without specifying a condition to a policy containing conditions is prohibited in non-interactive mode. Run the command again with \`--condition=None\`" >&2
      exit 1
    fi
    role="$(get_flag role "$@" || true)"
    fail_file="${GCLOUD_STUB_STATE_DIR}/project-binding-fail/${role//\//_}"
    if [[ -f "$fail_file" ]]; then
      err_msg="$(cat "$fail_file")"
      echo "${err_msg:-ERROR: (gcloud.projects.add-iam-policy-binding) PERMISSION_DENIED: simulated binding failure for role [${role}]}" >&2
      exit 1
    fi
    # On success real gcloud prints the updated policy on stdout and a
    # status line on stderr.
    echo "Updated IAM policy for project [${3:-}]." >&2
    echo "bindings: []"
    exit 0
    ;;
  "projects get-ancestors")
    # Empty output = "could not read ancestry" in deploy.sh, which just
    # skips the cross-org IAP check. Not the scenario under test here.
    exit 0
    ;;
  "services enable")
    require_project "$@"
    exit 0
    ;;
  "services list")
    require_project "$@"
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/services-list-should-fail" ]]; then
      echo "gcloud-stub: simulated services list failure" >&2
      exit 1
    fi
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/enabled-apis.txt" ]]; then
      cat "${GCLOUD_STUB_STATE_DIR}/enabled-apis.txt"
    else
      # Default: every required API except aiplatform.googleapis.com and
      # iam.googleapis.com is already enabled, so a default run makes one
      # `services enable` call, for exactly those two. The omissions are
      # deliberate: tests that check the enable call rely on iam being
      # missing here.
      cat <<'APIS'
compute.googleapis.com
run.googleapis.com
iap.googleapis.com
cloudbuild.googleapis.com
artifactregistry.googleapis.com
container.googleapis.com
APIS
    fi
    exit 0
    ;;
  "auth list")
    echo "stub-deployer@example.com"
    exit 0
    ;;
  "projects describe")
    echo "123456789012"
    exit 0
    ;;
  "run deploy")
    require_project "$@"
    require_flag region "$@"
    name="${3:-}"
    mkdir -p "${GCLOUD_STUB_STATE_DIR}/run-services"
    touch "${GCLOUD_STUB_STATE_DIR}/run-services/${name}.exists"
    exit 0
    ;;
esac

case "${1:-} ${2:-} ${3:-}" in
  "container clusters get-credentials")
    require_project "$@"
    get_flag location "$@" >/dev/null || {
      echo "gcloud-stub: missing --location on: $*" >&2
      exit 1
    }
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/get-credentials-should-fail" ]]; then
      echo "gcloud-stub: simulated get-credentials failure" >&2
      exit 1
    fi
    : "${KUBECONFIG:?KUBECONFIG must be set when calling get-credentials}"
    echo "fake-kubeconfig-for-${4:-}" > "$KUBECONFIG"
    exit 0
    ;;
  "config get-value account")
    echo "stub-deployer@example.com"
    exit 0
    ;;
  "config get-value project")
    # Deliberately a different, project-ID-shaped value from "account"
    # above: deploy.sh reads this as a literal PROJECT_ID fallback when
    # project_id is missing from its config, so returning the deployer's
    # email here (as a single two-word "config get-value" case matching
    # regardless of the property name once did) would silently feed an
    # email address into every --project= flag on that path.
    echo "demo-project"
    exit 0
    ;;
  "compute firewall-rules describe")
    require_project "$@"
    name="${4:-}"
    f="${GCLOUD_STUB_STATE_DIR}/firewall-rules/${name}.json"
    if [[ -f "$f" ]]; then
      format="$(get_flag format "$@")" || format=""
      if [[ "$format" == "value(targetTags)" ]]; then
        # A name-scoped fixture flag: the rule itself exists (the
        # unformatted describe above still succeeds), but this specific
        # --format=value(targetTags) read fails, e.g. a transient error
        # between two back-to-back describe calls. On failure, write only
        # to stderr and leave stdout empty, as real gcloud does; the
        # caller decides whether to discard stderr.
        if [[ -f "${f}.describe-target-tags-fail" ]]; then
          echo "gcloud-stub: simulated failure reading target tags for ${name}" >&2
          exit 1
        fi
        # Real gcloud's value() transform joins a repeated field with ";".
        # Prints nothing (not "[]" or similar) when the list is empty, same
        # as a real unscoped rule.
        "$PYTHON" -c "
import json, sys
d = json.load(open(sys.argv[1]))
print(';'.join(d.get('targetTags') or []))
" "$f"
      elif [[ "$format" == "value(sourceRanges,allowed[].map().firewall_rule().list(),targetTags)" ]]; then
        # The proxy-to-VM rule's own drift check reads all three fields in
        # one combined value() call instead of three separate ones. Real
        # gcloud's value() printer joins multiple requested fields with a
        # single tab, and joins each repeated field's own values
        # (sourceRanges, targetTags) with ";" -- verified by rendering
        # synthetic firewall-rule resources through the installed Cloud
        # SDK's own csv_printer.ValuePrinter, including the empty-field
        # case (renders as nothing between its two tabs, field position
        # preserved). The allowed-ports sub-expression mirrors
        # compute/transforms.py's TransformFirewallRule: each entry becomes
        # "PROTO:PORT" (or just "PROTO" with no ports), joined with ","
        # by list() -- see googlecloudsdk/command_lib/compute/
        # firewall_rules/flags.py, which is where deploy.sh's own
        # --format string comes from.
        "$PYTHON" -c "
import json, sys
d = json.load(open(sys.argv[1]))
source = ';'.join(d.get('sourceRanges') or [])
parts = []
for rule in d.get('allowed') or []:
    proto = rule.get('IPProtocol')
    ports = rule.get('ports')
    if ports:
        for p in ports:
            parts.append(f'{proto}:{p}')
    else:
        parts.append(proto)
allowed = ','.join(parts)
tags = ';'.join(d.get('targetTags') or [])
print('\t'.join([source, allowed, tags]))
" "$f"
      else
        cat "$f"
      fi
      exit 0
    fi
    exit 1
    ;;
  "compute firewall-rules update")
    require_project "$@"
    name="${4:-}"
    f="${GCLOUD_STUB_STATE_DIR}/firewall-rules/${name}.json"
    if [[ ! -f "$f" ]]; then
      echo "gcloud-stub: firewall rule ${name} not found" >&2
      exit 1
    fi
    # Real gcloud only touches the fields a flag was actually given for;
    # an update call with no --target-tags leaves the rule's existing
    # target tags alone, not clears them. Only write targetTags when
    # get_flag actually found the flag (its own exit status, not whether
    # the value came back empty -- "--target-tags=" is a valid, distinct
    # "clear the list" request from "the flag wasn't passed at all").
    if target_tags="$(get_flag target-tags "$@")"; then
      "$PYTHON" -c "
import json, sys
path, tags = sys.argv[1], sys.argv[2]
d = json.load(open(path))
d['targetTags'] = [t for t in tags.split(',') if t]
json.dump(d, open(path, 'w'))
" "$f" "$target_tags"
    fi
    exit 0
    ;;
  "compute firewall-rules create")
    require_project "$@"
    name="${4:-}"
    desc="$(get_flag description "$@")" || desc=""
    network="$(get_flag network "$@")" || network=""
    direction="$(get_flag direction "$@")" || direction=""
    action="$(get_flag action "$@")" || action=""
    rules="$(get_flag rules "$@")" || rules=""
    source_tags="$(get_flag source-tags "$@")" || source_tags=""
    source_ranges="$(get_flag source-ranges "$@")" || source_ranges=""
    target_tags="$(get_flag target-tags "$@")" || target_tags=""
    priority="$(get_flag priority "$@")" || priority=""

    proto="${rules%%:*}"
    if [[ "$proto" == "$rules" ]]; then
      ports=""
    else
      ports="${rules#*:}"
    fi

    "$PYTHON" "${LIB_DIR}/firewall-rule-json.py" \
      "$desc" "$network" "$direction" "$action" "$proto" "$ports" \
      "$source_tags" "$source_ranges" "$target_tags" "$priority" \
      > "${GCLOUD_STUB_STATE_DIR}/firewall-rules/${name}.json"
    exit 0
    ;;
  "compute firewall-rules delete")
    require_project "$@"
    name="${4:-}"
    f="${GCLOUD_STUB_STATE_DIR}/firewall-rules/${name}.json"
    if [[ -f "${f}.delete-fail" ]]; then
      if [[ -f "${f}.delete-fail-text" ]]; then
        cat "${f}.delete-fail-text" >&2
      else
        echo "gcloud-stub: simulated delete failure for ${name}" >&2
      fi
      exit 1
    fi
    if [[ -f "$f" ]]; then
      rm -f "$f"
      exit 0
    fi
    echo "gcloud-stub: firewall rule ${name} not found" >&2
    exit 1
    ;;
  "compute firewall-rules list")
    require_project "$@"
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/firewall-rules-list-should-fail" ]]; then
      echo "gcloud-stub: simulated list failure (permission denied)" >&2
      exit 1
    fi
    # --filter is applied the way real gcloud applies it, never ignored:
    # a form this stub does not implement fails loudly rather than
    # returning rules the real command would not.
    if filter="$(get_flag filter "$@")"; then
      filter_given=true
    else
      filter_given=false
      filter=""
    fi
    if [[ "$filter_given" == false || "$filter" == network[:~]* ]]; then
      if [[ -f "${GCLOUD_STUB_STATE_DIR}/firewall-rules-list-empty-stdout" ]]; then
        # A successful call that prints nothing at all -- distinct from a
        # genuinely empty JSON array ("[]") -- pins the caller's own
        # handling of zero-byte stdout, not just an empty list value.
        exit 0
      fi
      # Every rule in the project: the GKE-managed rules node-tag
      # discovery reads (gke-node-firewall-rules/, one JSON file per
      # rule, each carrying its own 'network' self-link URL, on whatever
      # network the fixture put it) and the hybrid tier's own rules
      # (firewall-rules/). Unfiltered, that is everything, on every
      # network, which is what the real unfiltered list returns.
      #
      # A network filter is emulated with documented gcloud semantics,
      # as the Compute API receives it:
      #   network:PATTERN  word match: PATTERN must match whole words of
      #                    the value; only a trailing * is a wildcard
      #                    (word-prefix match), so a leading * matches
      #                    nothing.
      #   network~REGEX    unanchored regular-expression search.
      "$PYTHON" -c "
import glob, json, os, re, sys
state_dir, given, flt = sys.argv[1], sys.argv[2] == 'true', sys.argv[3]
out = []
for p in sorted(glob.glob(os.path.join(state_dir, 'gke-node-firewall-rules', '*.json'))):
    with open(p) as f:
        out.append(json.load(f))
for p in sorted(glob.glob(os.path.join(state_dir, 'firewall-rules', '*.json'))):
    with open(p) as f:
        d = json.load(f)
    d['name'] = os.path.basename(p)[:-len('.json')]
    out.append(d)
if given:
    key, op, pat = flt[:len('network')], flt[len('network')], flt[len('network') + 1:]
    if op == ':':
        if pat.endswith('*'):
            rx = re.compile(r'\\b' + re.escape(pat[:-1]), re.I)
        else:
            rx = re.compile(r'\\b' + re.escape(pat) + r'\\b', re.I)
    else:
        rx = re.compile(pat)
    out = [r for r in out if rx.search(r.get(key) or '')]
print(json.dumps(out))
" "${GCLOUD_STUB_STATE_DIR}" "$filter_given" "$filter"
      exit 0
    fi
    # The teardown ownership check and the absence check list the tier's
    # own rules by exact name: name=(NAME ...), with = an equality match
    # against any listed name.
    name_list_re='^name=\(([a-z0-9-]+)( [a-z0-9-]+)*\)$'
    if [[ ! "$filter" =~ $name_list_re ]]; then
      echo "gcloud-stub: unsupported firewall-rules list --filter form: ${filter}" >&2
      exit 1
    fi
    inner="${filter#name=(}"
    inner="${inner%)}"
    "$PYTHON" -c "
import json, os, sys
names = sys.argv[1].split()
state_dir = sys.argv[2]
out = []
for n in names:
    p = os.path.join(state_dir, 'firewall-rules', n + '.json')
    if os.path.isfile(p):
        with open(p, encoding='utf-8') as f:
            d = json.load(f)
        d['name'] = n
        out.append(d)
print(json.dumps(out))
" "$inner" "${GCLOUD_STUB_STATE_DIR}"
    exit 0
    ;;
  "compute instances add-tags")
    require_project "$@"
    require_flag zone "$@"
    name="${4:-}"
    if [[ -n "$name" && -f "${GCLOUD_STUB_STATE_DIR}/instances/${name}.add-tags-fail" ]]; then
      echo "gcloud-stub: simulated add-tags failure for ${name}" >&2
      exit 1
    fi
    # Re-touches the same sentinel as "instances create" below: on the
    # existing-VM branch, this (and the hybrid-tier internal-IP calls
    # that follow it) is real work a create-mode wiring test needs to
    # have actually happened before it stops deploy.sh, not just the
    # earlier "does the VM exist" describe call that the sentinel alone
    # would fire on.
    touch "${GCLOUD_STUB_STATE_DIR}/vm-create-happened"
    exit 0
    ;;
  "compute instances list")
    require_project "$@"
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/instances-list-should-fail" ]]; then
      echo "gcloud-stub: simulated transient instances list failure" >&2
      exit 1
    fi
    if [[ -f "${GCLOUD_STUB_STATE_DIR}/instances-list-zone-unreachable" ]]; then
      # Emulates a real AggregatedList (no --zones) hitting an UNREACHABLE
      # zone: with the SDK's default compute/allow_partial_error=true,
      # that's downgraded to a stderr warning and exit 0 with the
      # unreachable zone's instances (including this one) missing from
      # stdout. Only CLOUDSDK_COMPUTE_ALLOW_PARTIAL_ERROR=false makes it a
      # hard error, matching real gcloud.
      echo "gcloud-stub: (simulated) Some requests did not succeed: - Failed to fetch some zones: ('Unreachable')" >&2
      if [[ "${CLOUDSDK_COMPUTE_ALLOW_PARTIAL_ERROR:-}" == "false" ]]; then
        exit 1
      fi
      exit 0
    fi
    filter="$(get_flag filter "$@")" || filter=""
    format="$(get_flag format "$@")" || format=""
    # Both callers look the VM up by exact name: name=NAME, with = an
    # equality match. Any other form fails loudly rather than being
    # answered as if it were that one.
    instance_name_re='^name=[a-z0-9-]+$'
    if [[ ! "$filter" =~ $instance_name_re ]]; then
      echo "gcloud-stub: unsupported instances list --filter form: ${filter}" >&2
      exit 1
    fi
    name="${filter#name=}"
    f="${GCLOUD_STUB_STATE_DIR}/instances/${name}"
    if [[ -f "$f" ]]; then
      if [[ "$format" == "value(name)" ]]; then
        echo "$name"
      else
        cat "$f"
      fi
